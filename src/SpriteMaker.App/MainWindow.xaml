<Window x:Class="SpriteMaker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SpriteMaker — 스케치로 도트 캐릭터 만들기"
        Width="1360" Height="860" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#2B2D31" Foreground="#E6E6E6"
        FontFamily="Malgun Gothic" FontSize="13"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#4A4D55" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#3C3F46" />
            <Setter Property="Foreground" Value="#E6E6E6" />
            <Setter Property="BorderBrush" Value="#565A63" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E6E6E6" />
        </Style>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FFFFFF" Geometry="M0,0 H2 V2 H0Z" />
                    <GeometryDrawing Brush="#E9E9E9" Geometry="M0,0 H1 V1 H0Z M1,1 H2 V2 H1Z" />
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <!-- 왼쪽: 그림 도구 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
            <StackPanel>
                <GroupBox Header="도구">
                    <StackPanel>
                        <RadioButton x:Name="PenTool" Content="펜 (B)" IsChecked="True" />
                        <RadioButton x:Name="EraserTool" Content="지우개 (E)" />
                        <RadioButton x:Name="FillTool" Content="채우기 (G)" />
                        <RadioButton x:Name="PickerTool" Content="스포이드 (I)" />
                        <TextBlock Margin="0,8,0,2">
                            <Run Text="굵기: " /><Run Text="{Binding Value, ElementName=BrushSize, StringFormat=0}" />
                        </TextBlock>
                        <Slider x:Name="BrushSize" Minimum="1" Maximum="48" Value="10" IsSnapToTickEnabled="True" TickFrequency="1" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="색">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Border x:Name="CurrentColorSwatch" Width="36" Height="36" BorderBrush="#AAA" BorderThickness="1" Background="#202020" />
                            <TextBox x:Name="HexBox" Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center"
                                     Text="#202020" LostFocus="HexBox_LostFocus" KeyDown="HexBox_KeyDown" />
                        </StackPanel>
                        <WrapPanel x:Name="PalettePanel" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="편집">
                    <StackPanel>
                        <Button Content="되돌리기 (Ctrl+Z)" Click="Undo_Click" />
                        <Button Content="다시 하기 (Ctrl+Y)" Click="Redo_Click" />
                        <Button Content="모두 지우기" Click="Clear_Click" />
                        <Button Content="이미지 불러오기…" Click="LoadImage_Click" />
                        <Button Content="스케치 저장…" Click="SaveSketch_Click" />
                    </StackPanel>
                </GroupBox>

                <TextBlock TextWrapping="Wrap" Foreground="#A0A4AC" FontSize="12">
                    캐릭터의 앞모습을 그리고 색을 채우세요. 선만 그려도 닫힌 영역은 흰색으로 채워집니다.
                    머리와 몸통 사이(목)를 잘록하게, 두 다리 사이를 띄워 그리면 부위를 잘 나눕니다.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>

        <!-- 가운데: 스케치 캔버스 -->
        <Border Grid.Column="1" Background="#1E1F22" CornerRadius="4">
            <Viewbox Margin="12" Stretch="Uniform">
                <Border Background="{StaticResource CheckerBrush}" BorderBrush="#555" BorderThickness="1">
                    <Image x:Name="SketchImage" Width="512" Height="512" Stretch="Fill" Cursor="Cross"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           MouseLeftButtonDown="Sketch_MouseDown" MouseMove="Sketch_MouseMove"
                           MouseLeftButtonUp="Sketch_MouseUp" MouseLeave="Sketch_MouseLeave" />
                </Border>
            </Viewbox>
        </Border>

        <!-- 오른쪽: 변환·미리보기·내보내기 -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Margin="10,0,0,0">
            <StackPanel>
                <GroupBox Header="도트 변환">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="캐릭터 높이(px)" VerticalAlignment="Center" />
                        <ComboBox x:Name="HeightBox" Grid.Column="1" SelectedIndex="2" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="16" />
                            <ComboBoxItem Content="24" />
                            <ComboBoxItem Content="32" />
                            <ComboBoxItem Content="48" />
                            <ComboBoxItem Content="64" />
                        </ComboBox>
                        <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="0,6,0,0">
                            <Run Text="색 수: " /><Run Text="{Binding Value, ElementName=ColorsSlider, StringFormat=0}" />
                        </TextBlock>
                        <Slider x:Name="ColorsSlider" Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Minimum="3" Maximum="32" Value="12"
                                IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Option_Changed" />
                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                            <CheckBox x:Name="OutlineBox" Content="외곽선" IsChecked="True" Click="Option_Changed" Margin="0,0,16,0" />
                            <CheckBox x:Name="FillEnclosedBox" Content="닫힌 영역 채우기" IsChecked="True" Click="Option_Changed" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="부위 나누기 (머리 / 몸통 / 다리)">
                    <StackPanel>
                        <Border Background="{StaticResource CheckerBrush}" HorizontalAlignment="Center" BorderBrush="#555" BorderThickness="1">
                            <Grid x:Name="LayoutPreviewHost">
                                <Image x:Name="SpritePreview" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                <Canvas x:Name="GuideCanvas" IsHitTestVisible="False" />
                            </Grid>
                        </Border>
                        <TextBlock Text="빨강=머리 끝, 초록=다리 시작, 노랑=다리 가르는 선" FontSize="11" Foreground="#A0A4AC" Margin="0,4" HorizontalAlignment="Center" />
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition /><RowDefinition /><RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Text="머리 끝 행" VerticalAlignment="Center" />
                            <Slider x:Name="HeadSlider" Grid.Column="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Layout_Changed" />
                            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=HeadSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="다리 시작 행" VerticalAlignment="Center" />
                            <Slider x:Name="HipSlider" Grid.Row="1" Grid.Column="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Layout_Changed" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=HipSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Text="다리 가운데" VerticalAlignment="Center" />
                            <Slider x:Name="CenterSlider" Grid.Row="2" Grid.Column="1" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Layout_Changed" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=CenterSlider}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <Button Content="자동으로 다시 나누기" Click="AutoLayout_Click" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="애니메이션 미리보기">
                    <StackPanel>
                        <ComboBox x:Name="ClipBox" SelectionChanged="ClipBox_SelectionChanged" />
                        <Border Margin="0,8,0,0" Background="#5E8C5A" HorizontalAlignment="Center" BorderBrush="#555" BorderThickness="1">
                            <Image x:Name="AnimPreview" Width="208" Height="208" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                        </Border>
                        <TextBlock x:Name="ClipInfo" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="#A0A4AC" FontSize="12" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="고닷으로 내보내기">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="이름" VerticalAlignment="Center" Width="40" />
                            <TextBox x:Name="NameBox" Width="200" Text="hero" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <Button x:Name="ExportButton" Content="폴더 선택 후 내보내기…" Click="Export_Click" IsEnabled="False" />
                        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#A0A4AC">
                            .png(시트) / _frames.tres(SpriteFrames) / .tscn(AnimatedSprite2D, 발밑이 원점) / .json 을 같은 폴더에 씁니다.
                            고닷 프로젝트 안의 폴더를 고르면 바로 씬에 끌어다 쓸 수 있습니다.
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#F0C674" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
